# ============================================
# Qhatu Frontend - Variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores reales.
# Solo se exponen variables con prefijo VITE_.
# ============================================

# URL base de la API del backend
VITE_API_URL=http://localhost:5010/api

# Entorno de la app
VITE_APP_ENV=development

# Google OAuth (client id público)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id

# WhatsApp de la tienda (público)
VITE_WHATSAPP_NUMERO=51999999999

# Información de la app
VITE_APP_NAME=Qhatu
VITE_APP_VERSION=1.0.0
