# ============================================
# Qhatu Backend - Variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# ============================================

# --- Base de datos ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=qhatu_db
DB_PORT=3306
# none | alter | force  (evita 'force' salvo en desarrollo con datos desechables)
DB_SYNC_MODE=none

# --- Autenticación ---
# Genera valores aleatorios largos, ej: openssl rand -hex 48
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRE=7d
COOKIE_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# --- Servidor ---
# Puerto del backend (evita el 5000 si otro software lo ocupa)
PORT=5010
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos separados por coma (opcional; por defecto usa FRONTEND_URL)
ALLOWED_ORIGINS=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# --- WhatsApp ---
WHATSAPP_NUMERO_TIENDA=51999999999
NOMBRE_TIENDA=CADENA COMERCIAL QHATU MARCA S.A.C.

# --- Seeds (solo desarrollo) ---
# Contraseña por defecto para los usuarios de prueba. Mínimo 8 caracteres.
# Los scripts de seed no usan contraseñas por defecto; fallan si no se define.
SEED_DEFAULT_PASSWORD=
# Overrides opcionales por rol:
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_VENDEDOR_PASSWORD=
# SEED_ALMACENERO_PASSWORD=
# SEED_CLIENTE_PASSWORD=
